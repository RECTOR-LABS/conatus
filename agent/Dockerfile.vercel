# Dockerfile.vercel — conatus audit worker (Slither/forge toolchain), slim build.
# Vercel autodetects Dockerfile.vercel at the service root and routes traffic to
# the process listening on $PORT (see vercel.json services.worker.root = agent/,
# entrypoint = Dockerfile.vercel). Build context = the worker service root (agent/).
#
# Slim rules (see PR notes): runtime binaries = forge + slither only
# (cast/anvil/chisel/solar are pruned — nothing in src/ invokes them),
# prod-only node_modules (tsx lives in dependencies), purges stay in the
# layer that created the bytes, and .dockerignore keeps host node_modules
# out of the build context.
FROM node:24-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-venv git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Foundry — keep forge only. Slither compiles via a temp Foundry workspace per audit.
RUN curl -L https://foundry.paradigm.xyz | bash \
 && /root/.foundry/bin/foundryup \
 && find /root/.foundry/versions -type f ! -name forge -delete \
 && rm -f /root/.foundry/bin/foundryup
ENV PATH="/root/.foundry/bin:${PATH}"
# IMPORTANT: Vercel's container runtime RESETS $PATH at runtime (unlike Railway), so the
# ENV PATH above is not honored when Slither spawns `forge` by name -> FileNotFoundError.
# Symlink the Foundry binaries onto the standard PATH (/usr/local/bin) so Slither's
# subprocess resolves them regardless of the runtime PATH.
# Keep HOME stable so forge/svm find the solc cache warmed below at runtime.
ENV HOME=/root
RUN ln -sf /root/.foundry/bin/forge /usr/local/bin/forge

# Slither in a venv (same layout as local: .venv/bin/slither); venv pip + pycache pruned.
RUN python3 -m venv /app/.venv \
 && /app/.venv/bin/pip install --no-cache-dir slither-analyzer \
 && rm -rf /app/.venv/bin/pip* /app/.venv/lib/python3*/site-packages/pip* \
 && find /app/.venv -type d -name '__pycache__' -prune -exec rm -rf {} +
ENV SLITHER_BIN=/app/.venv/bin/slither

# Pre-warm solc for the target pragma so the first audit doesn't pay a solc download
# (and doesn't depend on runtime network to binaries.soliditylang.org).
RUN mkdir -p /tmp/warm/src \
 && printf '[profile.default]\nsrc="src"\nout="out"\nevm_version="paris"\n' > /tmp/warm/foundry.toml \
 && printf '// SPDX-License-Identifier: MIT\npragma solidity ^0.8.20;\ncontract Warm { uint256 x; }\n' > /tmp/warm/src/Warm.sol \
 && (cd /tmp/warm && forge build) \
 && rm -rf /tmp/warm

WORKDIR /app/agent
COPY package.json pnpm-lock.yaml ./
RUN npm i -g pnpm@10.33.2 --no-fund --no-audit \
 && pnpm install --frozen-lockfile --prod \
 && npm -g rm pnpm \
 && rm -rf /root/.local/share/pnpm /root/.npm
COPY . ./

# Vercel injects PORT; src/server.ts reads process.env.PORT and binds 0.0.0.0.
# tsx runs from local node_modules — no corepack/pnpm needed at runtime.
EXPOSE 8787
CMD ["node_modules/.bin/tsx", "src/server.ts"]
